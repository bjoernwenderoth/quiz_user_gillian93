      "css": ".ds-seal{position:relative;width:230px;height:230px;border-radius:50%;border:1px solid #8a80575c;background:radial-gradient(ellipse at 35% 25%,#444330 0%,#2b3026 50%,#20251e 100%);box-shadow:0 22px 50px -25px #00000085,inset 0 1px 1px #d8c09b21;display:flex;align-items:center;justify-content:center;flex-direction:column}.ds-initial{font-family:var(--font-editorial);font-style:italic;font-size:160px;line-height:.8;color:var(--color-gold);padding-bottom:35px;padding-right:13px}.ds-caption{font-family:var(--font-sans);font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:#d6caaa;position:absolute;bottom:20%}"
    }
