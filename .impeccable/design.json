      "html": "<label class=\"ds-label\" for=\"ds-name\">Wie dürfen wir dich nennen? <span>Optional</span></label><input class=\"ds-name\" id=\"ds-name\" placeholder=\"Dein Vorname\" autocomplete=\"given-name\" maxlength=\"32\">",
      "css": ".ds-label{font-family:var(--font-sans);display:flex;justify-content:space-between;gap:10px;margin-bottom:11px;font-size:12px;color:var(--color-ink)}.ds-label span{font-size:10px;color:var(--color-muted)}.ds-name{font-family:var(--font-sans);box-sizing:border-box;min-height:52px;width:100%;padding:12px 45px 12px 17px;border:1px solid #42463b;border-radius:var(--radius-control);background:#1d201b;color:var(--color-ink);font-size:14px;caret-color:var(--color-gold);transition:border-color 150ms}.ds-name::placeholder{color:var(--color-muted)}.ds-name:hover{border-color:#777b6d}.ds-name:focus-visible{outline:2px solid var(--color-gold);outline-offset:5px;}"
    },
