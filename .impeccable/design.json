      "html": "<button class=\"ds-primary\">Los geht’s <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{font-family:var(--font-sans);border:0;background:var(--color-gold);color:#24271f;border-radius:var(--radius-control);display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:54px;padding:14px 25px;font-size:14px;font-weight:650;box-shadow:0 4px 10px #00000018;transition:background-color 150ms,box-shadow 150ms;cursor:pointer}.ds-primary:hover{background:#e8d5b4;box-shadow:0 5px 16px #00000024}.ds-primary:focus-visible{outline:2px solid var(--color-gold);outline-offset:5px;}.ds-primary:active{transform:scale(.96)}.ds-primary:disabled{opacity:.5;cursor:default}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active{transform:none}}"
