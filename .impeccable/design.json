  "narrative": {
    "northStar": "The Birthday Keepsake",
    "overview": "A personal dedication expressed through dark olive anthracite, warm ivory and champagne. Confident sans-serif typography supplies clarity; a restrained italic serif brings the warmth of a handwritten greeting. The recurring circular seal and geometric star give the interface its own recognizable identity.\n\nThe system pairs generous space with compact supporting information. Controls remain explicit and comfortably sized, and movement quietly marks arrivals, progress and celebration. Fonts ship locally. The palette, typography and component treatments are extracted from `src/styles.css`; motion comes from `src/design/motion.ts` and the React components.",
    "keyCharacteristics": [
      "Dark olive surfaces and warm champagne emphasis.",
      "Manrope structure, DM Sans reading, Instrument Serif sentiment.",
      "Fine outlines, gently curved controls and a circular keepsake signature.",
      "Clear feedback with text, symbols and color.",
      "Short, restrained motion that respects reduced-motion preferences."
    ],
    "rules": [
      {
        "name": "The Meaningful Feedback Rule",
        "body": "Correctness always pairs color with an icon and explicit wording.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve the olive anthracite, ivory and champagne relationship.",
      "Do use Manrope for structure, DM Sans for reading and Instrument Serif for personal emphasis.",
      "Do pair feedback color with wording and symbols.",
      "Do preserve visible keyboard focus and reduced-motion behavior.",
      "Do keep controls spacious on phones and fonts locally hosted."
    ],
    "donts": [
      "Don't extend the seal's decorative gradient and shadows to ordinary controls.",
      "Don't replace the quiet identity with saturated accents or dense decoration.",
      "Don't use color alone to distinguish correct and incorrect answers.",
      "Don't shrink mobile answer targets to fit the desktop grid.",
      "Don't invent personal imagery, age or biographical claims as decoration."
    ]
  }
}
