      "css": ".ds-wordmark{display:inline-flex;align-items:center;gap:13px;min-height:44px;text-decoration:none;color:var(--color-ink);font-family:var(--font-display);font-size:25px;font-weight:650;letter-spacing:-.04em}.ds-wordmark svg,.ds-dot{color:var(--color-gold)}.ds-wordmark:hover{color:var(--color-ink)}.ds-wordmark:focus-visible{outline:2px solid var(--color-gold);outline-offset:5px;}"
